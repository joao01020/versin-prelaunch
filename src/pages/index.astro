---
const appUrl = import.meta.env.PUBLIC_VERSIN_APP_URL ?? '';
const sbUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const sbKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? '';
const enabled = Boolean(sbUrl && sbKey);
