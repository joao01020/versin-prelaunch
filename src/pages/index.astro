<script>
  // Progresso e revelação sincronizados com o scroll, nos dois sentidos.
  const track = document.querySelector('#etapas .timeline-track');
  const items = [...document.querySelectorAll('#etapas .timeline-item')];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (track && items.length && !reduceMotion) {
    document.documentElement.classList.add('timeline-js');
    let scheduled = false;
    const update = () => {
      scheduled = false;
      // A linha acompanha a passagem do ponto de leitura pela timeline inteira.
      // Rolando para cima, o valor diminui naturalmente.
      const middle = window.innerHeight * .55;
      const trackRect = track.getBoundingClientRect();
      const fill = Math.max(0, Math.min(trackRect.height, middle - trackRect.top));
      track.style.setProperty('--timeline-progress', `${fill}px`);
      items.forEach((item) => {
        const rect = item.getBoundingClientRect();
        const distance = Math.abs(rect.top + rect.height / 2 - middle);
        const focus = distance < Math.min(window.innerHeight * .36, rect.height * .48);
        item.classList.toggle('is-visible', focus);
        item.classList.toggle('is-passed', rect.top + rect.height / 2 <= middle);
      });
    };
    const schedule = () => {
      if (!scheduled) { scheduled = true; requestAnimationFrame(update); }
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    window.addEventListener('pageshow', schedule);
    schedule();
  }
</script>
<footer class="footer shell"><div class="footer-main"><a href="#inicio" class="brand"><img src="/versin-logo.png" alt="" /><span class="brand-text"><strong>VERSIN</strong><small>BETA</small></span></a><p>Uma ideia de cada vez. Um verso de cada vez.</p></div><div class="footer-bottom"><small>© {new Date().getFullYear()} VERSIN. Projeto em desenvolvimento.</small><span>Feito para quem cria. ✦</span></div></footer>
<script define:vars={{sbUrl,sbKey,enabled,appUrl}}>
  const form = document.getElementById('beta-form');
  const message = document.getElementById('form-msg');
  const submit = document.getElementById('submit');
  const preference = document.getElementById('prefer-phone');
  const phoneField = document.getElementById('phone-field');
  const phoneInput = document.getElementById('phone');
  const receipt = document.getElementById('queue-receipt');
  const remaining = document.getElementById('queue-remaining');
  const total = document.getElementById('queue-total');
  const endpoint = sbUrl.replace(/\/$/, '');
  const headers = {'Content-Type':'application/json','apikey':sbKey,'Authorization':`Bearer ${sbKey}`};
  preference?.addEventListener('change', () => {
    phoneField.hidden = !preference.checked;
    phoneInput.required = preference.checked;
    if (!preference.checked) phoneInput.value = '';
  });
  if (enabled) {
    submit.disabled = false;
    message.textContent = 'A fila é registrada por ordem de inscrição. Os convites são enviados após validação.';
  }
  async function updateStats() {
    if (!enabled) return;
    try {
      const res = await fetch(`${endpoint}/rest/v1/rpc/versin_beta_queue_stats`,{method:'POST',headers,body:'{}',cache:'no-store'});
      if (!res.ok) return;
      const data = await res.json();
      if (data && Number.isFinite(Number(data.remaining))) {
        remaining.textContent = String(data.remaining);
        document.getElementById('queue-capacity').textContent=String(data.capacity);
        submit.disabled=Number(data.remaining)<=0;
        if(Number(data.remaining)<=0) message.textContent='Inscrições temporariamente encerradas. Aguarde novas vagas.';
        total.textContent = `· ${data.total} inscrições`;
      }
    } catch (_) { /* Mantém o contador em estado indisponível sem inventar vagas. */ }
  }
  updateStats();
  if (enabled) setInterval(updateStats,15000);
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!enabled) return;
    submit.disabled = true;
    message.classList.remove('success');
    message.textContent = 'Registrando sua inscrição…';
    const data = new FormData(form);
    try {
      const res = await fetch(`${endpoint}/rest/v1/rpc/request_versin_beta`, {
        method:'POST',headers,
        body:JSON.stringify({
          p_name:String(data.get('name')).trim(),
          p_email:String(data.get('email')).trim(),
          p_role:String(data.get('role')),
          p_prefer_phone:preference.checked,
          p_phone:preference.checked ? String(data.get('phone')).trim() : null
        })
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const result = await res.json();
      if (result?.status === 'registered') {
        message.textContent = 'Já existe uma solicitação para este e-mail. Por segurança, não exibimos os dados da inscrição anterior.';
        return;
      }
      if (result?.status === 'full') { message.textContent='As vagas acabaram. Aguarde novas liberações.'; updateStats(); return; }
      if (result?.status !== 'created' || !result.request_id || !Number.isSafeInteger(Number(result.queue_position))) throw new Error('Resposta inesperada');
      document.getElementById('receipt-position').textContent = `#${result.queue_position}`;
      document.getElementById('receipt-id').textContent = result.request_id;
      document.getElementById('receipt-note').textContent = result.first_group
        ? 'Você está entre os 20 primeiros inscritos. Sua prioridade será analisada antes da liberação do login.'
        : 'Sua solicitação está na fila das próximas liberações.';
      form.hidden = true;
      receipt.hidden = false;
      updateStats();
    } catch (_) {
      message.textContent = 'Não foi possível concluir o cadastro. Confira os dados e tente novamente.';
    } finally { await updateStats(); }
  });
  document.getElementById('copy-receipt')?.addEventListener('click', async () => {
    const id = document.getElementById('receipt-id').textContent;
    try { await navigator.clipboard.writeText(id); document.getElementById('copy-receipt').textContent = '✓ Copiado'; }
    catch (_) { document.getElementById('copy-receipt').textContent = 'Selecione o ID'; }
  });
</script>
<script>
  import {supabase, configured} from '../lib/supabase.js';
  import {loadAvatar,applyAvatar} from '../lib/avatar.js';
  const accountLink=document.getElementById('account-link');
  const headerActions=document.getElementById('header-actions');
  const requestLink=document.getElementById('request-link');
  const headerUser=document.getElementById('header-user');
  const headerLogout=document.getElementById('header-logout');
  if(configured && accountLink && requestLink && headerUser){
    const update=async()=>{
      const {data:{session}}=await supabase.auth.getSession();
      const loggedIn=Boolean(session);
      accountLink.classList.toggle('hidden', loggedIn);
      requestLink.classList.toggle('hidden', loggedIn);
      headerUser.classList.toggle('hidden', !loggedIn);
      if(loggedIn){const {data:{user}}=await supabase.auth.getUser();if(user)applyAvatar(headerUser.querySelector('.header-avatar'),await loadAvatar(user.id));}
      headerActions.dataset.authReady='true';
      accountLink.href='/login';
      accountLink.textContent='Entrar';
    };
    headerLogout?.addEventListener('click', async()=>{
      await supabase.auth.signOut();
      location.replace('/login');
    });
    update().catch(()=>{headerActions.dataset.authReady='true';});
    supabase.auth.onAuthStateChange((_event,session)=>{
      const loggedIn=Boolean(session);
      accountLink.classList.toggle('hidden', loggedIn);
      requestLink.classList.toggle('hidden', loggedIn);
      headerUser.classList.toggle('hidden', !loggedIn);
      if(loggedIn && session?.user){loadAvatar(session.user.id).then(url=>applyAvatar(headerUser.querySelector('.header-avatar'),url)).catch(()=>{});}
      headerActions.dataset.authReady='true';
    });
    window.addEventListener('pageshow',update);
  } else if(headerActions) { headerActions.dataset.authReady='true'; }
</script>
