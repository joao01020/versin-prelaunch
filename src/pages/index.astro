---
const appUrl = import.meta.env.PUBLIC_VERSIN_APP_URL ?? '';
const sbUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const sbKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? '';
const enabled = Boolean(sbUrl && sbKey);
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0c0a14" />
  <meta name="description" content="VERSIN: componha com assistência de IA, encontre artistas para colaborar e acompanhe registros por hash de letras, beats e projetos. Participe do Beta." />
  <meta property="og:title" content="VERSIN — Onde suas ideias ganham voz" />
  <meta property="og:description" content="Conheça o VERSIN e participe do programa de acesso antecipado. As primeiras 50 pessoas que contribuírem no Beta poderão conquistar PRO vitalício e o emblema Founder." />
  <meta property="og:type" content="website" />
  <link rel="icon" href="/versin-logo.png" />
  <title>VERSIN — Acesso antecipado</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
<div class="ambient amb-one"></div><div class="ambient amb-two"></div>
<header class="header shell">
  <a class="brand" href="#inicio" aria-label="VERSIN início"><img src="/versin-logo.png" alt="" /><span class="brand-text"><strong>VERSIN</strong><small>BETA</small></span></a>
  <nav aria-label="Navegação principal"><a href="#sobre">Conheça</a><a href="#founders">Founders</a><a href="#convite">Convite de Ouro</a><a href="#etapas">Como participar</a></nav>
  <a class="nav-cta" href="#inscricao">Pedir acesso <span>↗</span></a>
</header>
<main>
  <section class="hero shell" id="inicio">
    <div class="hero-copy">
      <div class="eyebrow"><span class="pulse"></span> VOCÊ RECEBEU UM CONVITE</div>
      <h1>Da composição à colaboração.<br /><em>Tudo em um só lugar.</em></h1>
      <p>Escreva suas letras com apoio de IA, desenvolva projetos com outros artistas e acompanhe registros por hash de letras, beats e colaborações.</p>
      <div class="hero-pills" aria-label="Recursos principais"><span>✎ Composição + IA</span><span>♫ Colaboração musical</span><span>⌗ Registro por hash</span></div>
      <div class="hero-actions"><a class="button primary" href="#inscricao">Quero testar o VERSIN <span>↗</span></a><a class="button textlink" href="#sobre">Descobrir como funciona ↓</a></div>
      <div class="hero-foot"><div class="avatar-cluster"><span>♪</span><span>✦</span><span>♫</span></div><p>Estamos reunindo os primeiros criadores.<br /><strong>Você pode fazer parte dessa história.</strong></p></div>
    </div>
    <div class="hero-visual" aria-label="Ilustração conceitual do espaço criativo VERSIN">
      <div class="orbit orbit-1"></div><div class="orbit orbit-2"></div>
      <div class="studio-card">
        <div class="window-header"><div class="dots"><i></i><i></i><i></i></div><span>SEU ESPAÇO CRIATIVO</span><span>⌘</span></div>
        <div class="studio-title"><div class="small-symbol"><img src="/versin-logo.png" alt="" /></div><div><small>MINHA COMPOSIÇÃO</small><strong>Primeiro verso</strong></div><span class="draft-tag">Rascunho</span></div>
        <div class="lyrics"><p>A ideia nasce no silêncio<span class="cursor"></span></p><p>e encontra a própria direção</p><p>cada palavra abre um caminho</p><p>cada verso, uma criação.</p></div>
        <div class="assistant-bubble"><div class="shine">✦</div><div><small>ASSISTENTE CRIATIVO</small><p>Peça rimas, examine sua letra ou aprofunde a mensagem.</p></div></div>
        <div class="bottom-bar"><div class="fake-wave"><i style="height:10px"></i><i style="height:19px"></i><i style="height:27px"></i><i style="height:14px"></i><i style="height:23px"></i><i style="height:12px"></i><i style="height:31px"></i><i style="height:18px"></i><i style="height:12px"></i><i style="height:24px"></i><i style="height:15px"></i><i style="height:9px"></i></div><span>Em construção, com você.</span></div>
      </div>
    </div>
  </section>
  <section class="mini-stats shell" aria-label="Informações do Beta"><div><span>01</span><strong>Primeira turma</strong><small>até 20 testadores</small></div><div><span>50</span><strong>Founders no total</strong><small>limite previsto para o programa</small></div><div><span>∞</span><strong>Reconhecimento</strong><small>PRO vitalício para quem contribuir</small></div></section>
  <section id="sobre" class="features shell section">
    <div class="section-heading">
      <div class="overline">CONHEÇA O VERSIN</div>
      <h2>Crie sua música.<br /><em>Encontre quem cria com você.</em></h2>
      <p>Da primeira letra ao projeto em conjunto: composição assistida, colaboração entre artistas e registros por hash no mesmo ambiente.</p>
    </div>
    <div class="concept-overview" aria-label="O que você pode fazer no VERSIN">
      <article class="concept-shot">
        <div class="concept-window">
          <span class="concept-label">COMPOSIÇÃO</span>
          <div class="concept-lines"><i class="w-85"></i><i class="w-70"></i><i class="w-55"></i></div>
        </div>
        <h3>Escreva sua letra</h3>
        <p>Desenvolva versos e organize seu processo de composição.</p>
      </article>
      <article class="concept-shot">
        <div class="concept-window ai-shot">
          <span class="concept-label">ASSISTENTE DE IA</span>
          <div class="concept-message">✦ Quer sugestões de rimas ou uma análise mais profunda da letra?</div>
        </div>
        <h3>Explore com IA</h3>
        <p>Peça rimas e avaliações com o nível de profundidade que escolher.</p>
      </article>
      <article class="concept-shot">
        <div class="concept-window projects-shot">
          <span class="concept-label">COLAB</span>
          <div class="concept-project"><b>♫</b><span>Projeto em colaboração<small>Artistas conectados</small></span></div>
          <div class="concept-project"><b>✎</b><span>Letra + beat<small>Criação conjunta</small></span></div>
        </div>
        <h3>Crie em conjunto</h3>
        <p>Conecte-se com artistas e inicie projetos musicais colaborativos.</p>
      </article>
      <article class="concept-shot">
        <div class="concept-window badge-shot">
          <span class="concept-label">REGISTRO POR HASH</span>
          <div class="hash-proof"><span>⌗</span><div><strong>Arquivo registrado</strong><small>SHA / impressão digital</small></div></div>
          <div class="hash-example">a8c4…e12f</div>
        </div>
        <h3>Acompanhe os registros</h3>
        <p>Letras, beats enviados e colaborações têm registros por hash.</p>
      </article>
    </div>
    <div class="feature-grid">
      <article class="feature">
        <div class="feature-icon">✎</div><small>COMPOSIÇÃO ASSISTIDA</small>
        <h3>Uma IA que acompanha sua escrita.</h3>
        <p>Busque rimas, peça sugestões e avalie sua letra de forma superficial ou aprofundada, sem abrir mão da autoria.</p>
        <div class="feature-art ai-art"><div>✦ &nbsp; Analise a mensagem deste refrão em profundidade.</div><span>Você escolhe como a IA participa →</span></div>
      </article>
      <article class="feature">
        <div class="feature-icon">♫</div><small>COLABORAÇÃO</small>
        <h3>Encontre artistas. Comece um projeto juntos.</h3>
        <p>O VERSIN aproxima criadores e reúne ferramentas para dar início a uma colaboração musical.</p>
        <div class="feature-art project-art"><div><b>♫</b><span>Nova collab<small>Composição compartilhada</small></span></div><div><b>✧</b><span>Artistas conectados<small>Projeto em andamento</small></span></div></div>
      </article>
      <article class="feature">
        <div class="feature-icon">⌗</div><small>RASTREABILIDADE</small>
        <h3>Registros por hash ao longo da criação.</h3>
        <p>Letras, beats enviados e projetos colaborativos recebem marcadores por hash, para conferir a integridade dos arquivos registrados.</p>
        <div class="feature-art hash-art"><span>⌗ REGISTRO GERADO</span><div class="hash-art-code">8e3b7a…4d91c2</div><small>Uma impressão digital do conteúdo</small></div>
      </article>
    </div>
    <p class="hash-disclaimer">O hash ajuda a identificar alterações e conferir a integridade de um conteúdo registrado. Por si só, não comprova autoria, data de criação ou titularidade de direitos autorais.</p>
  </section>
  <section id="founders" class="founders-wrap section"><div class="shell founders-grid"><div class="founders-copy"><div class="overline gold">PARA QUEM ACREDITOU DESDE O COMEÇO</div><h2>Não é só testar.<br /><em>É fazer parte da origem.</em></h2><p>Os primeiros participantes que contribuírem de verdade com o Beta poderão integrar o <strong>VERSIN Founders</strong> — um reconhecimento permanente pelo apoio ao projeto.</p><div class="founder-benefits"><div><span>✓</span><p><strong>VERSIN PRO vitalício</strong><small>Sem mensalidade do plano PRO, sujeito às condições do programa e uso justo dos recursos de IA.</small></p></div><div><span>✓</span><p><strong>Emblema Founder no perfil</strong><small>Um símbolo exclusivo de quem ajudou a construir o VERSIN desde o início.</small></p></div><div><span>✓</span><p><strong>Voz no desenvolvimento</strong><small>Compartilhe bugs, sugestões e suas experiências durante o Beta.</small></p></div></div></div>
    <div class="founder-card"><div class="card-rays"></div><div class="card-top"><span>VERSIN</span><span>FOUNDERS · BETA</span></div><div class="founder-medal"><img src="/versin-logo.png" alt="Símbolo VERSIN" /><span>✦</span></div><div class="card-center"><small>ACESSO DE FUNDADOR</small><strong>FOUNDER<span> ACCESS</span></strong><p>Para quem esteve aqui antes de todos.</p></div><div class="card-bottom"><span>PRO VITALÍCIO</span><span>✧ MEMBER</span></div></div></div></section>

  <!-- Primeiro capítulo do mistério: apenas o convite e o anúncio. Nenhuma charada ou prêmio automático ainda. -->
  <section id="convite" class="invitation-section section" aria-labelledby="invitation-title">
    <div class="shell invitation-layout">
      <div class="invitation-intro">
        <div class="overline gold">VERSIN / ARQUIVO 001</div>
        <h2>Algumas histórias começam <em>com um segredo.</em></h2>
        <p>Além do programa Founders, existe algo mais esperando para ser descoberto. Nenhum desafio é necessário para se inscrever no Beta.</p>
        <div class="mystery-badge"><span aria-hidden="true">✧</span><div><strong>ENIGMATIC FOUNDER</strong><small>Uma conquista secreta. Seu significado será revelado no momento certo.</small></div></div>
      </div>
      <div class="invitation-frame">
        <div class="invitation-label"><span>VERSIN / FOUNDERS PROGRAM</span><span aria-hidden="true">✦</span></div>
        <div class="golden-invitation" id="golden-invitation">
          <div class="invitation-crown" aria-hidden="true">♛</div>
          <div class="invitation-eyebrow">UM CONVITE ESPECIAL</div>
          <h3 id="invitation-title">Nem todos estarão aqui desde o começo.</h3>
          <p>Algumas pessoas vão conhecer o VERSIN quando ele estiver pronto. Outras terão a oportunidade de ajudar a construí-lo.</p>
          <div class="invitation-ticket">✧ &nbsp; GOLDEN INVITATION · 001–050</div>
          <button class="invitation-open" id="invitation-open" type="button" aria-expanded="false" aria-controls="invitation-reveal">Abrir o convite <span aria-hidden="true">↗</span></button>
          <div id="invitation-reveal" class="invitation-reveal" hidden>
            <div class="reveal-divider"></div>
            <span class="invitation-eyebrow">UM MISTÉRIO AINDA SEM RESPOSTA</span>
            <strong>ENIGMATIC FOUNDER</strong>
            <p>Há uma conquista escondida no universo VERSIN. Quem desvendar o futuro mistério poderá receber um emblema adicional de destaque no perfil, além dos benefícios Founders, quando elegível.</p>
            <small>A charada e os critérios da recompensa ainda serão anunciados. Abrir este convite não concede a conquista nem reserva uma vaga.</small>
          </div>
        </div>
        <p class="invitation-footnote">50 convites Founders no total · Primeira etapa: até 20 participantes</p>
      </div>
    </div>
  </section>
  <section id="etapas" class="how shell section"><div class="section-heading"><div class="overline">O CAMINHO ATÉ O LANÇAMENTO</div><h2>Começamos pequenos.<br /><em>Criamos algo grande juntos.</em></h2></div><div class="step-grid"><div class="step"><span class="step-num">01</span><div class="step-line"></div><h3>Primeiros 20 usuários</h3><p>Uma turma pequena para testar de perto e ajudar a encontrar os principais pontos de melhoria.</p><div class="step-status current">● ETAPA INICIAL</div></div><div class="step"><span class="step-num">02</span><div class="step-line"></div><h3>Expansão até 50</h3><p>Depois dos primeiros testes, novas pessoas poderão ser convidadas até o limite de 50 participantes.</p><div class="step-status">PRÓXIMA ETAPA</div></div><div class="step"><span class="step-num">03</span><div class="step-line"></div><h3>Reconhecimento Founders</h3><p>Quem contribuir e for aprovado no programa recebe os benefícios de fundador em sua conta.</p><div class="step-status">RECONHECIMENTO</div></div></div></section>
  <section id="inscricao" class="signup-shell shell section"><div class="signup-box"><div class="signup-decor">✶</div><div class="signup-heading"><div class="overline">SEU ACESSO COMEÇA NA FILA</div><h2>Seu lugar no começo<br /><em>do VERSIN.</em></h2><p>O acesso será liberado por ordem de inscrição. Os <strong>20 primeiros inscritos</strong> terão prioridade na fila para receber o convite de login e começar a testar o VERSIN.</p><div class="queue-highlights"><div><strong>Primeiros 20</strong><span>Prioridade na primeira turma Beta</span></div><div><strong>Próximos inscritos</strong><span>Entram na fila para futuras liberações</span></div></div><div class="note">✦ Estar na fila não ativa o login automaticamente. Os convites serão enviados em etapas após validação. PRO vitalício é um benefício dos Founders que contribuírem com o Beta.</div><div class="mystery-queue"><span>✧ ENIGMATIC FOUNDER</span><p>Um mistério, <strong>um único vencedor</strong>. O número total de pessoas que poderão participar do desafio ainda não foi divulgado. Os primeiros testadores terão uma vantagem: mais tempo para explorar o VERSIN assim que receberem acesso.</p></div></div><div class="signup-form-wrap"><div class="form-caption">ENTRAR NA FILA DE ACESSO</div><form id="beta-form"><label for="name">Como podemos chamar você?</label><input type="text" name="name" id="name" placeholder="Seu nome" minlength="2" maxlength="70" required autocomplete="name" /><label for="email">Seu melhor e-mail</label><input type="email" name="email" id="email" placeholder="voce@exemplo.com" required maxlength="254" autocomplete="email" /><label for="role">Você se identifica mais como...</label><select id="role" name="role" required><option value="" disabled selected>Selecione uma opção</option><option value="compositor">Compositor(a) / letrista</option><option value="artista">Artista / cantor(a)</option><option value="produtor">Produtor(a) musical</option><option value="entusiasta">Curioso(a) por música</option><option value="outro">Outro</option></select><label class="consent"><input type="checkbox" id="consent" required /><span>Concordo em receber um contato sobre o Beta pelo e-mail informado.</span></label><button type="submit" class="button primary submit" id="submit" disabled>Entrar na fila <span>↗</span></button><p class="form-msg" id="form-msg" role="status" aria-live="polite">Inscrições online serão liberadas após a configuração da lista de espera.</p></form></div></div></section>
  <section class="faq shell section"><div class="section-heading"><div class="overline">AINDA TEM DÚVIDAS?</div><h2>Perguntas rápidas.</h2></div><div class="faq-items"><details><summary>Preciso pagar para participar do Beta? <span>+</span></summary><p>Não. O programa de testes é gratuito para as pessoas convidadas e aprovadas.</p></details><details><summary>Entrar na fila garante acesso imediato? <span>+</span></summary><p>Não. As primeiras 20 inscrições têm prioridade na primeira turma, mas a liberação do login será feita em etapas e após validação. Outras inscrições ficam na fila para novas vagas.</p></details><details><summary>Quem pode conquistar o Enigmatic Founder? <span>+</span></summary><p>Será uma conquista secreta com um único vencedor. A quantidade total de participantes elegíveis ainda não foi divulgada. Os primeiros testadores poderão explorar antes, quando receberem acesso.</p></details><details><summary>Todos que entram na lista recebem PRO vitalício? <span>+</span></summary><p>Não. A lista é apenas um pedido de acesso. A recompensa é destinada aos participantes aprovados que efetivamente contribuírem durante os testes, dentro do limite de 50 Founders.</p></details><details><summary>O que significa PRO vitalício? <span>+</span></summary><p>É acesso ao plano PRO sem mensalidade enquanto o serviço existir, conforme as condições publicadas do programa. Recursos de IA poderão ter limites de uso justo para manter a sustentabilidade do projeto.</p></details><details><summary>O que preciso fazer como testador? <span>+</span></summary><p>Utilizar as ferramentas, compartilhar sua experiência e informar problemas ou sugestões. O objetivo é melhorar o VERSIN com feedback real.</p></details></div></section>
</main>
<script>
  const invitationButton = document.getElementById('invitation-open');
  const invitationReveal = document.getElementById('invitation-reveal');
  invitationButton?.addEventListener('click', () => {
    if (!invitationReveal || !invitationButton) return;
    const willOpen = invitationReveal.hidden;
    invitationReveal.hidden = !willOpen;
    invitationButton.setAttribute('aria-expanded', String(willOpen));
    invitationButton.textContent = willOpen ? 'Fechar convite −' : 'Abrir o convite ↗';
  });
</script>
<footer class="footer shell"><div class="footer-main"><a href="#inicio" class="brand"><img src="/versin-logo.png" alt="" /><span class="brand-text"><strong>VERSIN</strong><small>BETA</small></span></a><p>Uma ideia de cada vez. Um verso de cada vez.</p></div><div class="footer-bottom"><small>© {new Date().getFullYear()} VERSIN. Projeto em desenvolvimento.</small><span>Feito para quem cria. ✦</span></div></footer>
<script define:vars={{sbUrl,sbKey,enabled,appUrl}}>
  const form = document.getElementById('beta-form');
  const message = document.getElementById('form-msg');
  const submit = document.getElementById('submit');
  if (enabled) { submit.disabled = false; message.textContent = 'A fila é registrada por ordem de inscrição. O convite de login será enviado depois, conforme a liberação do Beta.'; }
  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!enabled) return;
    submit.disabled = true; message.textContent = 'Enviando sua solicitação…';
    const data = new FormData(form);
    try {
      const response = await fetch(`${sbUrl.replace(/\/$/,'')}/rest/v1/rpc/request_versin_beta`, {
        method: 'POST', headers: { 'Content-Type': 'application/json', 'apikey': sbKey, 'Authorization': `Bearer ${sbKey}` },
        body: JSON.stringify({ p_name: String(data.get('name')).trim(), p_email: String(data.get('email')).trim(), p_role: String(data.get('role')) })
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const result = await response.json();
      message.textContent = result === 'priority'
        ? 'Inscrição registrada na primeira turma! Você tem prioridade na fila dos 20 primeiros. Aguarde seu convite de login por e-mail.'
        : result === 'waiting'
          ? 'Inscrição registrada! Você está na fila para as próximas liberações. Aguarde contato por e-mail.'
          : 'Este e-mail já possui uma solicitação. Consulte sua caixa de entrada para novidades.';
      message.classList.add('success'); form.reset();
    } catch(err) { message.textContent = 'Não foi possível enviar agora. Tente novamente mais tarde.'; message.classList.remove('success'); }
    finally { submit.disabled = false; }
  });
</script>
</body></html>
