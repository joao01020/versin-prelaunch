<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Configurações | VERSIN Beta</title><link rel="icon" href="/versin-logo.png"/><link rel="stylesheet" href="/account.css"/></head><body>
<header><a class="brand" href="/"><img src="/versin-logo.png" alt=""/><span>VERSIN<small>BETA</small></span></a><a class="admin-back" href="/dashboard">Voltar ao painel ↗</a></header>
<main><div id="loading" class="panel">Verificando sua sessão…</div><div id="content" class="hidden"><div class="overline">MINHA CONTA</div><h1>Configurações</h1><div class="settings-grid"><section class="panel"><small>FOTO DE PERFIL</small><form id="avatar-form" class="avatar-picker-form"><input class="visually-hidden" id="avatar-file" type="file" accept="image/jpeg,image/png,image/webp" aria-label="Escolher foto de perfil" required/><label class="avatar-picker" for="avatar-file" title="Escolher uma foto" aria-label="Clique para alterar sua foto de perfil" tabindex="0"><span class="settings-avatar" id="settings-avatar" aria-hidden="true"><svg viewBox="0 0 96 96" width="66" height="66"><circle cx="48" cy="32" r="18" fill="currentColor"/><path d="M13 86c2-22 16-33 35-33s33 11 35 33" fill="currentColor"/></svg></span><span class="avatar-camera" aria-hidden="true"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h3l2-3h6l2 3h3v12H4z"/><circle cx="12" cy="13" r="3.2"/></svg></span></label><p class="avatar-picker-hint" id="avatar-hint">Clique na foto para escolher uma imagem</p><p class="avatar-picker-subhint">JPG, PNG ou WebP · até 2 MB</p><button type="submit" class="primary avatar-save hidden" id="avatar-save">Salvar nova foto</button></form><p id="avatar-result" class="notice" role="status"></p></section>
<section class="panel"><small>SEGURANÇA DA CONTA</small><p>Conta: <strong id="email"></strong></p><p>Defina ou altere sua senha. O acesso por link enviado ao e-mail continua disponível.</p><form id="password-form"><label for="new-password">Nova senha</label><input type="password" id="new-password" minlength="12" autocomplete="new-password" required placeholder="Mínimo de 12 caracteres"/><label for="confirm-password">Confirmar nova senha</label><input type="password" id="confirm-password" minlength="12" autocomplete="new-password" required/><button type="submit" class="primary">Atualizar senha</button></form><p id="password-result" class="notice" role="status"></p></section></div></div><p id="error" class="notice" role="status"></p></main>
<script>
import {supabase,configured} from '../lib/supabase.js';
import {loadAvatar,applyAvatar} from '../lib/avatar.js';
const $=id=>document.getElementById(id);let currentUser;let previewUrl=null;
$('avatar-file').addEventListener('change',()=>{
 const f=$('avatar-file').files?.[0];const m=$('avatar-result');
 if(previewUrl){URL.revokeObjectURL(previewUrl);previewUrl=null;}
 if(!f){$('avatar-save').classList.add('hidden');return;}
 if(!['image/jpeg','image/png','image/webp'].includes(f.type)||f.size>2*1024*1024){
   m.textContent='Escolha uma imagem JPG, PNG ou WebP com até 2 MB.';
   $('avatar-file').value='';$('avatar-save').classList.add('hidden');return;
 }
 previewUrl=URL.createObjectURL(f);
 const container=$('settings-avatar');
 container.replaceChildren();const img=document.createElement('img');img.src=previewUrl;img.alt='Prévia da nova foto';container.append(img);
 $('avatar-hint').textContent='Gostou? Salve sua nova foto.';m.textContent='';$('avatar-save').classList.remove('hidden');
});
$('avatar-file').addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();$('avatar-file').click();}});
$('settings-avatar').closest('label').addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();$('avatar-file').click();}});
async function load(){if(!configured){$('loading').textContent='Supabase não configurado.';return}const {data:{user},error}=await supabase.auth.getUser();if(error||!user){location.replace('/login');return}currentUser=user;$('email').textContent=user.email||'—';$('loading').classList.add('hidden');$('content').classList.remove('hidden');applyAvatar($('settings-avatar'),await loadAvatar(user.id));}
$('avatar-form').addEventListener('submit',async e=>{e.preventDefault();const f=$('avatar-file').files?.[0];if(!f)return;const m=$('avatar-result');if(!['image/jpeg','image/png','image/webp'].includes(f.type)||f.size>2*1024*1024){m.textContent='Escolha JPG, PNG ou WebP de até 2 MB.';return}m.textContent='Salvando foto…';try{const bmp=await createImageBitmap(f);const c=document.createElement('canvas');c.width=256;c.height=256;const ctx=c.getContext('2d');if(!ctx)throw new Error('Canvas indisponível');const side=Math.min(bmp.width,bmp.height);ctx.drawImage(bmp,(bmp.width-side)/2,(bmp.height-side)/2,side,side,0,0,256,256);bmp.close();const blob=await new Promise(res=>c.toBlob(res,'image/webp',.85));if(!blob)throw new Error('Falha ao converter imagem');const {error}=await supabase.storage.from('beta-avatars').upload(`${currentUser.id}/avatar.webp`,blob,{upsert:true,contentType:'image/webp',cacheControl:'0'});if(error)throw error;applyAvatar($('settings-avatar'),await loadAvatar(currentUser.id));m.textContent='Foto atualizada! Ela aparecerá na home e no dashboard ao abrir essas páginas.';$('avatar-save').classList.add('hidden');$('avatar-hint').textContent='Clique na foto para trocar novamente';if(previewUrl){URL.revokeObjectURL(previewUrl);previewUrl=null;}$('avatar-file').value='';}catch(err){m.textContent='Não foi possível salvar: '+err.message;}});
$('password-form').addEventListener('submit',async e=>{e.preventDefault();const m=$('password-result'),a=$('new-password').value,b=$('confirm-password').value;if(a!==b){m.textContent='As senhas não coincidem.';return}if(a.length<12){m.textContent='Use pelo menos 12 caracteres.';return}m.textContent='Atualizando senha…';const {error}=await supabase.auth.updateUser({password:a});m.textContent=error?'Não foi possível atualizar: '+error.message:'Senha atualizada com sucesso.';if(!error)$('password-form').reset();});
load().catch(err=>{$('loading').textContent='Falha ao carregar configurações';$('error').textContent=err.message});
</script></body></html>