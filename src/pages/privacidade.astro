  <style>
    :root{color-scheme:dark}*{box-sizing:border-box}body{margin:0;background:#0c0a14;color:#f8f3ff;font-family:'DM Sans',sans-serif;line-height:1.7}a{color:#d2a7ff}a:hover{color:#f2dfff}.shell{width:min(850px,calc(100% - 36px));margin:auto}.top{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:27px 0;border-bottom:1px solid #ffffff16}.brand{display:inline-flex;gap:10px;align-items:center;color:#fff;text-decoration:none;font:700 21px 'Space Grotesk',sans-serif;letter-spacing:.07em}.brand img{width:36px;height:36px;object-fit:contain}.back{text-decoration:none;font-size:13px;border:1px solid #71518b;border-radius:999px;padding:9px 14px}.content{padding:65px 0 100px}.eyebrow{color:#be93ff;letter-spacing:.17em;font-size:11px;font-weight:700}h1,h2{font-family:'Space Grotesk',sans-serif;letter-spacing:-.035em;line-height:1.18}h1{font-size:clamp(34px,5vw,56px);margin:14px 0 22px}h2{font-size:21px;margin:0 0 13px}p,li{color:#bcb1cc;font-size:15px}p{margin:0 0 12px}section{padding:27px 0;border-bottom:1px solid #ffffff14}section:first-of-type{padding-top:0}ul{padding-left:22px}li{margin:8px 0}.notice{background:#22192e;border:1px solid #59416f;border-radius:15px;padding:19px 22px;margin-bottom:20px}.notice p{margin:0}.foot{padding:25px 0 40px;font-size:12px;color:#9d90af}@media(max-width:600px){.content{padding-top:45px}.back{font-size:12px}}
  </style>
  <link rel="stylesheet" href="/cookie-consent.css" />
